# Copy to .env (a default .env is committed) and adjust.
# Host port where nginx serves the app: http://localhost:${APP_PORT}
APP_PORT=80
# Default profile for `docker compose up`. `docker compose --profile gpu up` overrides it.
COMPOSE_PROFILES=cpu
# Streams created on first start when the stream list is empty (JSON list of {name, site, url, camera_type}).
# For the demo cameras: DEFAULT_STREAMS='[{"name":"Касса","url":"rtsp://mediamtx:8554/cam1","camera_type":"webcam"}]'
# (or the full list in demo-videos/demo-cams.json).
DEFAULT_STREAMS=
