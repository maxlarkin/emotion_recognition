{
  "$description": "Дизайн-токены EmoSense. Тёмная тема, плоский стиль, острые углы.",
  "color": {
    "bg": {
      "page":      "#0B1220",
      "sidebar":   "#111A2B",
      "toolbar":   "#111A2B",
      "panel":     "#152036",
      "panelAlt":  "#0F1828",
      "control":   "#1B2840",
      "active":    "#1E2D4A",
      "hover":     "#18243A",
      "dropdown":  "#22304A",
      "dropdownItemHover": "#2C3C5C",
      "video":     "#070C16"
    },
    "border": {
      "default": "#26344F",
      "subtle":  "#1E2B43",
      "row":     "#1C2840",
      "control": "#2E3D5A",
      "strong":  "#3A4C6C"
    },
    "text": {
      "primary":   "#FFFFFF",
      "body":      "#D3DAE6",
      "secondary": "#B4BFD1",
      "muted":     "#8C99B0",
      "placeholderMarker": "#3A4A66",
      "link":      "#9DBDFF",
      "linkHover": "#C9DAFF"
    },
    "accent": {
      "primary": "#4C8DFF",
      "focusRing": "#9DBDFF"
    },
    "status": {
      "live":       "#3DD68C",
      "connecting": "#F5B544",
      "offline":    "#8C99B0",
      "liveBadge":  "#FF5A5F"
    },
    "decision": {
      "alert":   { "bg": "#FF8A3D", "fg": "#0B1220", "panelBg": "#2A1E14", "border": "#FF8A3D", "softBorder": "#8A5A3A" },
      "watch":   { "bg": "#3A2614", "fg": "#FFB27A" },
      "abstain": { "bg": "#26344F", "fg": "#D3DAE6", "bar": "#5A6A88" },
      "none":    { "bg": "#1E2B43", "fg": "#B4BFD1" },
      "positive":{ "bg": "#163329", "fg": "#8EE3BC" }
    },
    "warning": { "bg": "#2E2A16", "border": "#6B5A20", "fg": "#F5E3A8" }
  },
  "font": {
    "family": {
      "sans": "'IBM Plex Sans', system-ui, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap",
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "size": {
      "h1": "22px",
      "h2": "18px",
      "h3": "16px",
      "logo": "16px",
      "body": "14px",
      "small": "13px",
      "caption": "12px",
      "micro": "11px"
    },
    "lineHeight": 1.45,
    "usage": {
      "mono": "время, числа, вероятности, разрешения, адреса потоков"
    }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px" },
  "radius": { "default": "0", "dot": "50%" },
  "shadow": {
    "dropdown": "0 16px 40px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.4)",
    "active":   "0 6px 18px rgba(0,0,0,.45)",
    "panelRaised": "0 8px 20px rgba(0,0,0,.4)",
    "rule": "Тени только у выпадающих меню и активных/раскрытых элементов. Всё остальное — плоское."
  },
  "size": {
    "toolbarHeight": "44px",
    "toolbarButtonHeight": "36px",
    "menuItemHeight": "40px",
    "controlHeight": "32px",
    "settingsRowMinHeight": "48px",
    "alertBannerHeight": "32px",
    "alertButtonHeight": "24px",
    "sidebarWidth": "260–340px (не более 30% ширины)",
    "iconButton": "32–44px",
    "statusDot": "8px"
  },
  "selection": {
    "activeListItem": "background color.bg.active + border 1px accent.primary + inset 3px 0 0 accent.primary + shadow.active",
    "selectedRow": "inset 2px 0 0 accent.primary"
  }
}
